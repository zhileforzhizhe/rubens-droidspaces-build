# ===== DroidSpaces 容器支持配置（配合官方 kABI 补丁使用） =====

# 进程间通信（容器核心依赖，需先打 DroidSpaces 官方 kABI 补丁）
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y

# 命名空间（容器隔离）
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# 设备管理
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# 注意以下三项必须保持 n！都会改变 vendor 模块内联读取的结构体布局：
# - CFS_BANDWIDTH：往 struct rq 中段插限流字段（v5 崩溃根因，scheduler 模块）。
# - CGROUP_DEVICE / CGROUP_PIDS：会增大 CGROUP_SUBSYS_COUNT，撑大 css_set
#   头部的 subsys[] 数组并挪动子系统索引（v6 崩溃头号嫌疑，millet 系模块）。
# 容器 CPU 限额、device/pids cgroup 隔离功能因此牺牲。

# KernelSU（保住 root 权限，源码织入）
CONFIG_KSU=y
