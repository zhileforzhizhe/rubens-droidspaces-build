# ===== DroidSpaces 容器支持配置（配合官方 kABI 补丁使用） =====

# 进程间通信（容器核心依赖，需先打 DroidSpaces 官方 kABI 补丁）
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y

# 命名空间（容器隔离）
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# 设备管理与控制组
CONFIG_CGROUP_DEVICE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y

# KernelSU（保住 root 权限，源码织入）
CONFIG_KSU=y
