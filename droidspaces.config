# ===== DroidSpaces 容器支持配置（配合官方 kABI 补丁使用） =====

# 进程间通信（容器核心依赖，需先打 DroidSpaces 官方 kABI 补丁）
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y

# 命名空间（容器隔离）
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# 设备管理
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# 容器 IPv6 NAT（NAT66）：让 NAT 模式容器有 IPv6 出网。
# 官方确认 kABI 安全——纯新增 netfilter 表，不改任何 vendor 模块读取的结构体布局。
# IP6_NF_IPTABLES / IP6_NF_FILTER / IP6_NF_MANGLE / IPV6_MULTIPLE_TABLES 原厂已开，不重复。
# 官方清单里的 NF_CONNTRACK_IPV6 / NF_NAT_IPV6 / ANDROID_PARANOID_NETWORK
# 在 5.10 源码中已不存在（老内核遗留符号），写入会被丢弃，故不写。
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# CPU 限额与 pids cgroup（实验性）：kABI 布局保全补丁（patches/cpu-pids/）
# 用尾部扩展 + 空结构体占位技巧，在不改变原厂结构体布局的前提下开启：
# - CFS_BANDWIDTH：容器 cpu.cfs_quota_us / cpu.cfs_period_us CPU 限额。
# - CGROUP_PIDS：容器 pids.max 进程数限额。
# CGROUP_DEVICE 仍保持关闭（补丁未覆盖 device 子系统）。
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y

# Macvlan 虚拟网卡：--net=macvlan 模式依赖（App 检查里的"Macvlan support"项）。
# kABI 安全——drivers/net/macvlan.c 是纯新增自包含驱动（rtnl_link 注册），
# 不改任何既有结构体布局；check 的 ds_nl_probe_macvlan 探针（veth 上建
# bridge 模式 macvlan）靠它转绿。原厂配置为 not set，无隐藏依赖。
CONFIG_MACVLAN=y

# KernelSU（保住 root 权限，源码织入）
CONFIG_KSU=y

# NTsync：容器 Wine/Windows 游戏的 NT 同步原语（Wine 9+/Proton 标配）。
# kABI 安全——drivers/misc/ntsync.c 纯新增驱动，lockdep 改动全是宏级。
# 补丁来源：Goldzxcbug/Droidspaces_Kernel_patch（android12-5.10 适配已验证机型含 K50U/K60）。
CONFIG_NTSYNC=y
