# ===== DroidSpaces 容器支持配置（配合官方 kABI 补丁使用） =====

# 进程间通信（容器核心依赖，需先打 DroidSpaces 官方 kABI 补丁）
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y

# 命名空间（容器隔离）
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# 设备管理与控制组
CONFIG_CGROUP_DEVICE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUP_PIDS=y
# 注意：CFS_BANDWIDTH 必须保持 n！它会在 struct rq 中段插入限流字段，
# 挪动 vendor 模块内联读取的偏移（v5 崩溃根因）。容器 CPU 限额功能因此牺牲。

# KernelSU（保住 root 权限，源码织入）
CONFIG_KSU=y
