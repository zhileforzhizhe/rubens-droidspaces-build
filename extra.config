# ===== 与原厂配置的仅有差异（全部不影响 vendor 模块兼容性） =====

# LTO：全量 -> Thin。只改代码生成方式，不改任何数据结构，模块兼容不受影响；
# 全量 LTO 在 16GB 内存的免费编译机上容易内存不足，Thin 更快更稳。
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set

# 关闭未用符号裁剪：原厂的裁剪白名单文件（abi_symbollist.raw）不在源码里，
# 禁用后只是多导出一些符号（严格超集），模块照样全部能加载。
# CONFIG_TRIM_UNUSED_KSYMS is not set

# 版本字符串与原厂逐字节一致（uname -r 看起来就是原厂）
CONFIG_LOCALVERSION="-android12-9-00019-g4ea09a298bb4-ab12292661"
# CONFIG_LOCALVERSION_AUTO is not set
